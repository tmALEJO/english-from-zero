{
  "name": "english-from-zero",
  "private": true,
  "version": "0.1.0",
  "description": "App para aprender inglés desde cero (hispanohablantes). Web local en PC + APK Android. 100% gratis y offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview --open",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "content:check": "python scripts/validate_content.py",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/text-to-speech": "6.1.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/share": "7.0.4",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.2.0",
    "html5-qrcode": "^2.3.8",
    "lz-string": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.0"
  }
}
