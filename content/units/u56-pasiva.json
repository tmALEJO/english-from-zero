      },
      {
       "en": "People speak Spanish here. → Spanish is spoken here.",
       "es": "La gente habla español aquí. → Aquí se habla español.",
       "mark": [
        "is spoken"
       ]
      },
      {
       "en": "Edison invented the light bulb. → The light bulb was invented by Edison.",
       "es": "Edison inventó el bombillo. → El bombillo fue inventado por Edison.",
       "mark": [
        "was invented"
       ]
      },
      {
       "en": "The workers built the bridge in 1990. → The bridge was built in 1990.",
       "es": "Los obreros construyeron el puente en 1990. → El puente fue construido en 1990.",
       "mark": [
        "was built"
       ]
      }
     ],
     "question": "¿Cómo se forma la voz pasiva?",
     "options": [
      "be (is/was) + participio",
      "do + verbo",
      "will + verbo"
     ],
     "answer": 0,
     "rule": "La VOZ PASIVA pone el foco en la cosa, no en quien hace la acción: be + participio (is made, was built). Presente: is/are + participio. Pasado: was/were + participio. Si quieres decir quién lo hizo, usa by. En español muchas veces la traducimos con 'se': Spanish is spoken = se habla español.",
     "ruleExamples": [
      {
       "en": "These shoes are made of leather. They were made in Italy.",
       "es": "Estos zapatos son de cuero. Fueron hechos en Italia."
      }
     ]
