    {
     "type": "dialogue",
     "title": "Visita a una finca cafetera",
     "scene": "☕ Un guía explica el proceso del café.",
     "lines": [
      {
       "who": "Guide",
       "en": "Welcome to the farm! The coffee is grown on these hills.",
       "es": "¡Bienvenidos a la finca! El café se cultiva en estas lomas."
      },
      {
       "who": "Tourist",
       "en": "When is it harvested?",
       "es": "¿Cuándo se cosecha?"
      },
      {
       "who": "Guide",
       "en": "Twice a year. The beans are picked by hand, one by one.",
       "es": "Dos veces al año. Los granos se recogen a mano, uno por uno."
      },
      {
       "who": "Tourist",
       "en": "And then?",
       "es": "¿Y después?"
      },
      {
       "who": "Guide",
       "en": "They're washed and dried in the sun. Then they're roasted and ground.",
       "es": "Se lavan y se secan al sol. Luego se tuestan y se muelen."
      },
      {
       "who": "Tourist",
       "en": "Is all the coffee exported?",
       "es": "¿Todo el café se exporta?"
      },
      {
       "who": "Guide",
       "en": "Most of it is exported, but the best part is drunk right here!",
       "es": "La mayoría se exporta, ¡pero la mejor parte se toma aquí mismo!"
      }
     ]
    }
