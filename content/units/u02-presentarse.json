    {
      "id": "u02-l3",
      "title": "Yo soy, tú eres",
      "focus": "grammar",
      "newItems": ["u02.iam", "u02.youare", "u02.wherefrom", "u02.from"],
      "activities": [
        { "type": "present", "items": ["u02.wherefrom", "u02.from"] },
        { "type": "discover",
          "topic": "Verbo to be (I am / you are)",
          "intro": "Lee y escucha estas frases. No busques reglas todavía, solo mira.",
          "examples": [
            { "en": "I am Sam.", "es": "Yo soy Sam.", "mark": ["am"] },
            { "en": "I am tired.", "es": "Yo estoy cansado.", "mark": ["am"] },
            { "en": "I am from Colombia.", "es": "Yo soy de Colombia.", "mark": ["am"] },
            { "en": "You are Lia.", "es": "Tú eres Lia.", "mark": ["are"] },
            { "en": "You are happy.", "es": "Tú estás feliz.", "mark": ["are"] },
            { "en": "You are from Peru.", "es": "Tú eres de Perú.", "mark": ["are"] }
          ],
          "question": "¿Qué notaste? 'am' y 'are' significan…",
          "options": ["Solo 'soy'", "Solo 'estoy'", "Las dos: 'ser' y 'estar'"],
          "answer": 2,
          "rule": "En inglés 'ser' y 'estar' son el mismo verbo: to be. Con I va am (I am). Con you va are (you are). Se acorta así: I'm, you're.",
          "ruleExamples": [
            { "en": "I'm Sam. I'm tired.", "es": "Soy Sam. Estoy cansado." },
            { "en": "You're from Colombia.", "es": "Eres de Colombia." }
          ]
        },
        { "type": "fill", "en": "I ___ from Colombia.", "es": "Soy de Colombia.", "options": ["am", "are"], "answer": 0, "explain": "Con I siempre va am." },
        { "type": "fill", "en": "You ___ happy.", "es": "Estás feliz.", "options": ["am", "are"], "answer": 1, "explain": "Con you va are." },
        { "type": "fill", "en": "I ___ tired.", "es": "Estoy cansado.", "options": ["am", "are"], "answer": 0 },
        { "type": "auto", "items": ["u02.iam", "u02.youare", "u02.wherefrom", "u02.from"], "modes": ["listen-pick", "build"] }
      ]
    },
