    {
     "type": "discover",
     "topic": "Phrasal verbs: el significado no es literal",
     "intro": "Compara el verbo solo con el phrasal verb.",
     "examples": [
      {
       "en": "I can't stand this noise. → I can't put up with this noise.",
       "es": "No soporto este ruido.",
       "mark": [
        "put up with"
       ]
      },
      {
       "en": "She invented a story. → She made up a story.",
       "es": "Se inventó una historia.",
       "mark": [
        "made up"
       ]
      },
      {
       "en": "We postponed the meeting. → We put off the meeting.",
       "es": "Pospusimos la reunión.",
       "mark": [
        "put off"
       ]
      },
      {
       "en": "He solved the problem. → He sorted out the problem.",
       "es": "Resolvió el problema.",
       "mark": [
        "sorted out"
       ]
      }
     ],
     "question": "Un 'phrasal verb' es…",
     "options": [
      "un verbo con un número",
      "un verbo + una partícula que cambia su significado",
      "un verbo irregular"
     ],
     "answer": 1,
     "rule": "Un phrasal verb es un verbo + una partícula (up, out, off, into…) que juntos tienen un significado propio, muchas veces distinto del verbo solo. 'put' es poner, pero 'put up with' es soportar.",
     "ruleExamples": []
    }
   ]
